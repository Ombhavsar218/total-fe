{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Django admin and API (including WhiteNoise-served static files).
	@backend path /api /api/* /admin /admin/* /static /static/* /media /media/* /health /health/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Immutable fingerprinted Vite assets.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# React single-page app with client-side routing.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "{$HSTS_HEADER:max-age=0}"
		-Server
	}
}

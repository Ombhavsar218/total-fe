# Django
DJANGO_SECRET_KEY="change-me-in-production"
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# Database. Leave DATABASE_URL empty to use the bundled SQLite database.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/totalstock
DATABASE_URL=

# Frontend origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# Optional: trusted HTTPS origins for Django admin CSRF
# CSRF_TRUSTED_ORIGINS=https://totalstock.example.com

# Database connection reuse (seconds)
DB_CONN_MAX_AGE=60

# JWT lifetimes (minutes / days)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

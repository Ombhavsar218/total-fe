# Copy this file to .env and replace every change-me value before deploying.
# The file is read by Docker Compose and is intentionally ignored by git.

COMPOSE_PROJECT_NAME=totalstock

# Public hostname. Use localhost for a local test, or your DuckDNS name in production.
DOMAIN=totalstock.duckdns.org
ACME_EMAIL=you@example.com

# HSTS is disabled by default so localhost testing is safe. After HTTPS is verified,
# replace the value below with: max-age=31536000; includeSubDomains
HSTS_HEADER=max-age=0

HTTP_PORT=80
HTTPS_PORT=443

# Django
# Generate with: openssl rand -hex 32
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret
DJANGO_ALLOWED_HOSTS=totalstock.duckdns.org,localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
DB_CONN_MAX_AGE=60

# Browser origins allowed to call the API and trusted for Django admin CSRF.
CORS_ALLOWED_ORIGINS=https://totalstock.duckdns.org
CSRF_TRUSTED_ORIGINS=https://totalstock.duckdns.org

# PostgreSQL
# Use a long, URL-safe password (letters/numbers/hyphen) because it is embedded in DATABASE_URL.
# Generate with: openssl rand -hex 24
# POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=totalstock
POSTGRES_USER=totalstock
POSTGRES_PASSWORD=change-me-use-a-long-url-safe-password

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Automatic backups written to ./backups inside the repository.
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
